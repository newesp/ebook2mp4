+class VideoJoinPreviewJob(MergeVideoJob):
+    def release(self, *, discard=True):
+        if not self.wait(0):
+            raise ProjectError('請等待影音接點準備停止。')
+        try:
+            if self.folder.exists(): shutil.rmtree(self.folder)
+        except OSError:
+            raise ProjectError('影音接點暫存仍被占用，請停止播放後重試。') from None
+
